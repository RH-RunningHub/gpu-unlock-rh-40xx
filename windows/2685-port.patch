+    manifest = json.loads(fetch_artifacts.MANIFEST.read_text())
+    source, package = fetch_artifacts.inputs(manifest)
+    source = fetch_artifacts.fetch(source, args.cache, args.offline)
+    # Local adaptation: the pinned CachyOS nvidia-utils-610.43.03-1-x86_64_v3 package
+    # was pruned from archive.cachyos.org (404). generate_v67.py reads only three
+    # members from it (.PKGINFO, usr/lib/firmware/nvidia/610.43.03/gsp_ga10x.bin,
+    # the NVIDIA license notice) and builds both V67 payloads deterministically in
+    # code. Those three members are supplied as standalone cache files instead, each
+    # verified against the SAME pinned SHA-256 values the package path enforced
+    # (gsp 57237362..., license c692fb14..., pkgver 610.43.03-1); the payload outputs
+    # are verified against their own pins, as in generate_v67.py main().
+    cache_pkginfo = args.cache / "nvidia-610.43.03-PKGINFO"
+    cache_gsp = args.cache / "nvidia-610.43.03-gsp_ga10x.bin"
+    cache_license = args.cache / "nvidia-610.43.03-NVIDIA-LICENSE"
+    if cache_gsp.is_file() and cache_license.is_file() and cache_pkginfo.is_file():
+        sys.path.insert(0, str(ROOT / "firmware"))
+        import generate_v67
+        notice = manifest["source_artifacts"][2]["notice"]
+        if fetch_artifacts.digest(cache_gsp) != generate_v67.GSP_SHA256:
+            raise ValueError("standalone gsp_ga10x.bin does not match its pinned SHA-256")
+        if fetch_artifacts.digest(cache_license) != notice["sha256"]:
+            raise ValueError("standalone NVIDIA license does not match its pinned SHA-256")
+        if f"pkgver = {generate_v67.PACKAGE_VERSION}" not in cache_pkginfo.read_text(encoding="utf-8", errors="replace").splitlines():
+            raise ValueError("standalone PKGINFO version does not match 610.43.03-1")
+        gsp = cache_gsp.read_bytes()
+        payload = generate_v67.build_payload()
+        if generate_v67.sha256(payload) != generate_v67.PAYLOAD_SHA256:
+            raise ValueError("generated GA102 V67 image differs from its pinned SHA-256")
+        ad102_payload = generate_v67.build_ad102_payload()
+        if generate_v67.sha256(ad102_payload) != generate_v67.AD102_PAYLOAD_SHA256:
+            raise ValueError("generated AD102 V67 image differs from its pinned SHA-256")
+        args.output.mkdir(parents=True, exist_ok=True)
+        (args.output / "gsp_ga10x.bin").write_bytes(gsp)
+        (args.output / "v67-ga102-610.43.03.bin").write_bytes(payload)
+        (args.output / generate_v67.AD102_PAYLOAD_NAME).write_bytes(ad102_payload)
+        (args.output / "NVIDIA-LICENSE").write_bytes(cache_license.read_bytes())
+        print("package input replaced by file-level pinned members (gsp/license/PKGINFO); payload pins verified")
+    else:
+        package_path = fetch_artifacts.fetch(package, args.cache, args.offline)
+        subprocess.run([sys.executable, str(ROOT / "firmware/generate_v67.py"),
+                        str(package_path), str(args.output)], check=True)
     prefix = "NVIDIA-kernel-module-source-610.43.03/src/nvidia/generated/"
